# Port the backend listens on. Most hosts (Railway/Render) set this automatically.
PORT=3001

# Where the frontend is served from. The backend will only accept requests from this origin.
# Local dev: http://localhost:5173
# Production: https://your-frontend.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# Supabase connection
# Find these in your Supabase project: Settings → API
# - SUPABASE_URL: "Project URL"
# - SUPABASE_SERVICE_ROLE_KEY: "service_role" key (KEEP SECRET — never commit, never put in frontend)
# If both are unset, the backend falls back to an in-memory store (data resets on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
