# ─── Server ─────────────────────────────────────────────────────────────────
# Port the backend listens on. Most hosts (Railway/Render) set this automatically.
PORT=3001

# Where the frontend is served from. The backend will only accept requests from this origin.
# Local dev:  http://localhost:5173
# Production: https://your-frontend.example.com
ALLOWED_ORIGIN=http://localhost:5173

# ─── Authentication ─────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Generate a long random string for production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-for-production

# How long tokens stay valid. Examples: 1h, 12h, 7d, 30d
JWT_EXPIRES_IN=7d

# Seeded admin user (only used the FIRST time the database is created).
# Change these before deploying to production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_DISPLAY_NAME=Admin

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite file path. Relative to the backend folder. Default: data/app.db
# Set to ":memory:" for an ephemeral in-memory DB (used by tests).
DATABASE_PATH=data/app.db
